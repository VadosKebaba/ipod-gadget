# Runs the iAP client (https://github.com/oandrew/ipod) on /dev/iap0.
# The head unit only sees the iPod while /dev/iap0 is open, so this keeps it open.
# Installed by install-rpi.sh when it's given the client binary.
[Unit]
Description=iPod accessory protocol client for ipod-gadget
After=systemd-modules-load.service
# keep retrying: /dev/iap0 only exists once the gadget has bound to the USB controller
StartLimitIntervalSec=0

[Service]
# -d puts the iAP traffic in the journal; the trace file is what to attach when
# reporting a head unit problem upstream (view it with: ipod view <file>)
# the client doesn't truncate the trace, so start each run on a fresh file and keep
# the previous run (the one to look at after a crash or a dropped connection)
ExecStartPre=-/bin/mv -f /var/lib/ipod/ipod.trace /var/lib/ipod/ipod.trace.prev
ExecStart=/usr/local/bin/ipod -d serve -w /var/lib/ipod/ipod.trace /dev/iap0
StateDirectory=ipod
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
