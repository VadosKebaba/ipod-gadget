# Runs the iAP client (https://github.com/oandrew/ipod) on /dev/iap0.
# The head unit only sees the iPod while /dev/iap0 is open, so this keeps it open.
# Installed by install-rpi.sh when it's given the client binary.
[Unit]
Description=iPod accessory protocol client for ipod-gadget
After=systemd-modules-load.service
# keep retrying: /dev/iap0 only exists once the gadget has bound to the USB controller
StartLimitIntervalSec=0

[Service]
# IPOD_GLOBAL_ARGS, e.g. "--legacy": must match the kernel side (g_ipod_hid legacy_hid),
# see the comments in /etc/default/ipod-client and the README
EnvironmentFile=-/etc/default/ipod-client
# Every non-empty trace is kept: it's what to attach when reporting a head unit problem
# (view one with: ipod view <file>). The client doesn't truncate its trace, so each run
# starts on a fresh file. Named by date, plus a counter when that name is taken: a Pi
# without an RTC battery boots to the same 1970 time every time, so dates repeat.
ExecStartPre=-/bin/sh -c 'f=/var/lib/ipod/ipod.trace; [ -s "$$f" ] || exit 0; t=/var/lib/ipod/ipod-$$(date +%%Y%%m%%d-%%H%%M%%S); n=$$t.trace; i=1; while [ -e "$$n" ]; do n=$$t-$$i.trace; i=$$((i+1)); done; mv "$$f" "$$n"'
# -d puts the iAP traffic in the journal; global flags have to come before "serve"
ExecStart=/usr/local/bin/ipod -d $IPOD_GLOBAL_ARGS serve -w /var/lib/ipod/ipod.trace /dev/iap0
StateDirectory=ipod
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
